# Copy to .env to override defaults. Nothing here is required: `docker compose up --build` works without a .env file.
# Never commit a real .env.

# Host ports
WEB_PORT=8080
MAILPIT_PORT=8025

# Public URL of the web app, used in email links
APP_BASE_URL=http://localhost:8080

# SMTP (defaults deliver to the bundled Mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Ticketing <no-reply@ticketing.local>

# Set to true when served over HTTPS
COOKIE_SECURE=false

# Build-time: show an "Open Mailpit" shortcut on the check-your-email screen (set false with a real SMTP server)
SHOW_MAILPIT_LINK=true
