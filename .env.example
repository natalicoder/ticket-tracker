# Copy to .env to override defaults. Nothing here is required: `docker compose up --build` works without a .env file.
# Never commit a real .env.

# Host port
WEB_PORT=8080

# Public URL of the web app, used in email links
APP_BASE_URL=http://localhost:8080

# SMTP (defaults: DataArt relay, reachable from the office network or VPN)
SMTP_HOST=relay1.dataart.com
SMTP_PORT=25
SMTP_SECURE=false
# true: never use STARTTLS. false: accept an internal or self-signed relay certificate.
SMTP_IGNORE_TLS=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Ticketing <no-reply@ticketing.local>

# Set to true when served over HTTPS
COOKIE_SECURE=false

# Offline mode: catch all mail in a local Mailpit inbox (http://localhost:MAILPIT_PORT) instead of the relay.
# Uncomment all five lines together.
# COMPOSE_PROFILES=mailpit
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SHOW_MAILPIT_LINK=true
# MAILPIT_PORT=8025
